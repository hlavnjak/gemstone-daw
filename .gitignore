/target
/gemstone-daw.log
*.log

# The embedded LeSynth Fourier VST3 plugin is committed precompiled so the DAW
# runs without needing the separate lesynth-fourier source tree. Ignore the rest
# of internal_plugins/ (local rebuilds for other platforms, etc.) but keep the
# shipped binaries.
/internal_plugins/*
!/internal_plugins/.gitkeep
!/internal_plugins/liblesynth_fourier.so
!/internal_plugins/lesynth_fourier.dll
!/internal_plugins/liblesynth_fourier.dylib

# Local scratch / recordings — not part of the repo.
/my_voice.m4a
/notes
/misc_notes
/track1.lsft
/MAC_TEST_SETUP.md

# Python bytecode from the tools/ scripts.
__pycache__/

# macOS signing: the filled-in settings and any key material — never commit.
/packaging/macos/sign.env
/packaging/macos/sign.env.example
/packaging/macos/SIGNING.md
/packaging/macos/gemstone.entitlements
*.p8
*.p12
*.cer
